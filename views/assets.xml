<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="jalali_lang_inject" inherit_id="web.layout" name="Jalali Lang Inject">
        <xpath expr="//head" position="inside">
            <script type="text/javascript">
                window.ODOO_LANG_IS_JALALI = false;
                <t t-if="request.env.user.lang and request.env.user.lang.startswith('fa')">
                window.ODOO_LANG_IS_JALALI = true;
                </t>
            </script>
        </xpath>
    </template>
</odoo>
